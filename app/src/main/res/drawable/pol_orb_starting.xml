<?xml version="1.0" encoding="utf-8"?>
<!-- Pol: round connect button, "starting" state. Soft halo + gradient disc + thin light rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="50%"
                android:startColor="#66A855F7"
                android:centerColor="#22A855F7"
                android:endColor="#00A855F7" />
        </shape>
    </item>
    <item
        android:bottom="22dp"
        android:left="22dp"
        android:right="22dp"
        android:top="22dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FFC026D3"
                android:endColor="#FF06B6D4"
                android:type="linear" />
            <stroke
                android:width="2dp"
                android:color="#55FFFFFF" />
        </shape>
    </item>
</layer-list>
